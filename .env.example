# Example for MongoDB Atlas:
# MONGODB_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp
FRONTEND_URL=http://localhost:5173

# Local development. Containers should use Production (see docker-compose.yml).
ASPNETCORE_ENVIRONMENT=Development

# PORT is intentionally not set here: the app falls back to 5000 locally, and in
# containers Compose or the hosting platform (Render) supplies the value.
