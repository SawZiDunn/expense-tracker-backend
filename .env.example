# Example for MongoDB Atlas:
# MONGODB_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp
FRONTEND_URL=http://localhost:5173

# ASPNETCORE_ENVIRONMENT is intentionally NOT set here. This file is loaded by
# DotNetEnv *after* WebApplication.CreateBuilder has already resolved the environment,
# so a value here has no effect. Set it as a real process variable instead (Compose,
# `docker run -e`, Render, or your shell) when you need Development behaviour.
#
# ASPNETCORE_ENVIRONMENT=Development